FROM python:3.14-slim

WORKDIR /app

COPY requirements-inference.txt .
RUN pip install --no-cache-dir -r requirements-inference.txt

COPY inference/ ./inference/
COPY scripts/infer_entrypoint.sh ./scripts/infer_entrypoint.sh
RUN chmod +x ./scripts/infer_entrypoint.sh

ENV PYTHONPATH=/app
EXPOSE 8787

# CANN and the Ascend driver are mounted from the node at runtime. Keeping
# them outside the image makes this image match the installed 8.2.RC1 stack.
ENTRYPOINT ["/app/scripts/infer_entrypoint.sh"]
